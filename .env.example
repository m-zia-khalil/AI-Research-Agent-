# Copy this file to ".env" and put your real key in the copy.
# ".env" is in .gitignore, so it is never uploaded to GitHub.
# Get a free key at https://console.groq.com/keys

GROQ_API_KEY=your-groq-key-here

# Optional. Your email makes Crossref/OpenAlex treat you as a "polite" user with better limits.
CONTACT_EMAIL=

# Optional. A free OpenAlex key raises your OpenAlex limits; it works without one.
OPENALEX_API_KEY=

# Keeps CrewAI quiet: no usage telemetry and no "view your traces?" prompt.
CREWAI_DISABLE_TELEMETRY=true
CREWAI_TRACING_ENABLED=false
